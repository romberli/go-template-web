    "paths": {
        "/api/v1/cron/run": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cron"
                ],
                "summary": "run a job once immediately, does not affect the job schedule",
                "parameters": [
                    {
                        "description": "job id, takes precedence over job_name",
                        "name": "job_id",
                        "in": "body",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "description": "job name",
                        "name": "job_name",
                        "in": "body",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "{\"message\": \"job run completed\"}",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
